GOOGLE_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
MISTRAL_API_KEY=your_api_key_here

# Retrieval backend: keep chroma for the deployed baseline; use qdrant for RAG v2.
RAG_BACKEND=chroma

# Local PostgreSQL and Qdrant
DATABASE_URL=postgresql+psycopg://rag_app:rag_local_only@localhost:5432/rag_portfolio
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=municipality_rag_docs_v2
