GOOGLE_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
MISTRAL_API_KEY=your_api_key_here

# Structured answer generation and answer classification.
LLM_MODEL_NAME=gemini-3.1-flash-lite
CLASSIFIER_MODEL_NAME=gemini-3.1-flash-lite

# Retrieval backend: qdrant is the active RAG v2 path; use chroma for baseline comparison.
RAG_BACKEND=qdrant

# Local PostgreSQL and Qdrant
DATABASE_URL=postgresql+psycopg://rag_app:rag_local_only@localhost:5432/rag_portfolio
QDRANT_URL=http://localhost:6333
# Local Qdrant does not require a key. Set this only for Qdrant Cloud.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=municipality_rag_docs_v2_contextual_heading_v1
