{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rag/answer-output-v2.schema.json",
  "title": "Grounded answer output v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claims", "missing_conditions", "date_calculations"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "missing_conditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/missing_condition" }
    },
    "date_calculations": {
      "type": "array",
      "items": { "$ref": "#/$defs/date_calculation" }
    }
  },
  "$defs": {
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "non_empty_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "ordinal", "text", "evidence_element_ids", "evidence_kind"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^claim-[1-9][0-9]*$" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 },
        "evidence_element_ids": { "$ref": "#/$defs/non_empty_evidence_ids" },
        "evidence_kind": {
          "enum": ["text", "table_cell", "flow_edge", "form_field", "timeline_event"]
        }
      }
    },
    "missing_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "evidence_element_ids"],
      "properties": {
        "type": {
          "enum": ["case_fact", "policy_judgment", "missing_document", "version_conflict"]
        },
        "description": { "type": "string", "minLength": 1 },
        "evidence_element_ids": { "$ref": "#/$defs/evidence_ids" }
      }
    },
    "date_calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculation_id",
        "result_label",
        "anchor_date",
        "offset_value",
        "offset_unit",
        "counting_rule",
        "cutoff_time",
        "evidence_element_ids"
      ],
      "properties": {
        "calculation_id": { "type": "string", "pattern": "^date-[1-9][0-9]*$" },
        "result_label": { "type": "string", "minLength": 1 },
        "anchor_date": { "type": "string", "format": "date" },
        "offset_value": { "type": "integer", "minimum": 1, "maximum": 3660 },
        "offset_unit": { "const": "calendar_day" },
        "counting_rule": {
          "enum": ["next_day_is_day_1", "anchor_day_is_day_1"]
        },
        "cutoff_time": {
          "type": ["string", "null"],
          "format": "time"
        },
        "evidence_element_ids": { "$ref": "#/$defs/non_empty_evidence_ids" }
      }
    }
  }
}
