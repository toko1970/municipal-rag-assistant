{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/text-holdout-public-manifest-v1.schema.json",
  "title": "Text sealed holdout public manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "holdout_id",
    "state",
    "paths_relative_to",
    "manifest_schema",
    "gold_schema",
    "blueprint",
    "development_manifest",
    "questions",
    "documents",
    "gold",
    "candidate",
    "predictions",
    "opening",
    "results"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "holdout_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "PLANNED",
        "SEALED",
        "CANDIDATE_FROZEN",
        "PREDICTIONS_FROZEN",
        "OPENED",
        "CONSUMED"
      ]
    },
    "paths_relative_to": {"const": "repository_root"},
    "manifest_schema": {"$ref": "#/$defs/repositoryArtifact"},
    "gold_schema": {"$ref": "#/$defs/repositoryArtifact"},
    "blueprint": {"$ref": "#/$defs/repositoryArtifact"},
    "development_manifest": {"$ref": "#/$defs/repositoryArtifact"},
    "questions": {
      "oneOf": [
        {"type": "null"},
        {
          "allOf": [
            {"$ref": "#/$defs/repositoryArtifact"},
            {
              "type": "object",
              "required": ["scenario_count", "expression_count"],
              "properties": {
                "scenario_count": {"const": 50},
                "expression_count": {"const": 100}
              }
            }
          ]
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "document_family", "format", "sha256"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "document_family": {"type": "string", "minLength": 1},
          "format": {"const": "markdown"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "gold": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario_sha256", "scenario_count", "expression_count"],
          "properties": {
            "scenario_sha256": {"$ref": "#/$defs/sha256"},
            "scenario_count": {"const": 50},
            "expression_count": {"const": 100}
          }
        }
      ]
    },
    "candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["git_commit", "config_manifest_sha256", "frozen_at"],
          "properties": {
            "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "config_manifest_sha256": {"$ref": "#/$defs/sha256"},
            "frozen_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "predictions": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "sha256", "attempt_count", "frozen_at"],
          "properties": {
            "run_id": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"},
            "attempt_count": {"const": 100},
            "frozen_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    },
    "opening": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["opened_at", "scenario_hash_verified"],
          "properties": {
            "opened_at": {"type": "string", "format": "date-time"},
            "scenario_hash_verified": {"const": true}
          }
        }
      ]
    },
    "results": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/repositoryArtifact"}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repositoryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "scenario_count": {"type": "integer", "minimum": 0},
        "expression_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
